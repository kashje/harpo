# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Database
DATABASE_URL="postgresql://username:password@database:5432/harpo"

# Redis
REDIS_URL="redis://redis:6379"

# Rate limiting: RATE_LIMIT_AMOUNT requests per RATE_LIMIT_TIME seconds
RATE_LIMIT_AMOUNT=60
RATE_LIMIT_TIME=60

# Application settings (see src/env.js)
NEXT_PUBLIC_LAST_VIEW_COUNTDOWN_SECONDS=60 # Seconds a revealed secret is visible before destruction
# Secrets (shhhh)
URL_ID_ENC_KEY=""
CREATOR_FINGERPRINT_SALT=""

# Storage
STORAGE_ADAPTER=local # supported: local (default)
STORAGE_BASE_PATH=/tmp/harpo-storage
# Maximum upload size in bytes (default: 100MB)
MAX_UPLOAD_SIZE_BYTES=104857600 # For local storage, I recommend setting this to 100MB
