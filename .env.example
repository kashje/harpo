# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Redis (the only datastore; runs without persistence, see compose.yml)
REDIS_URL="redis://redis:6379"

# Rate limiting per client IP: RATE_LIMIT_AMOUNT requests per RATE_LIMIT_TIME seconds
RATE_LIMIT_AMOUNT=60
RATE_LIMIT_TIME=60
# Creating secrets is throttled separately: CREATE_RATE_LIMIT_AMOUNT per CREATE_RATE_LIMIT_TIME seconds
CREATE_RATE_LIMIT_AMOUNT=30
CREATE_RATE_LIMIT_TIME=600
# Number of reverse proxies in front of Harpo that append to X-Forwarded-For (used to find the client IP)
TRUSTED_PROXY_COUNT=1

# Secrets (shhhh)
# 32-byte key encoded as base64: openssl rand -base64 32
URL_ID_ENC_KEY=""
CREATOR_FINGERPRINT_SALT=""

# Storage, for file secrets. File sharing is off without a STORAGE_ADAPTER.
STORAGE_ADAPTER=local # supported: local, s3
STORAGE_BASE_PATH=/tmp/harpo-storage
# Set to true to turn off file sharing, whatever STORAGE_ADAPTER says (default: false)
# DISABLE_STORAGE=false
# Maximum upload size in bytes (default: 100MB)
MAX_UPLOAD_SIZE_BYTES=104857600 # For local storage, I recommend setting this to 100MB

# S3 storage, used with STORAGE_ADAPTER=s3. Works with any S3-compatible service; see docs/SELF_HOST.md.
# S3_BUCKET=harpo
# S3_REGION=us-east-1
# Leave S3_ENDPOINT unset for AWS; set it for other services (e.g. https://<account-id>.r2.cloudflarestorage.com)
# S3_ENDPOINT=
# Without keys, the AWS SDK looks for credentials itself (AWS_* variables, an IAM role, ...)
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Most self-hosted services (MinIO, Garage, SeaweedFS, ...) need path-style URLs
# S3_FORCE_PATH_STYLE=false
# Key prefix, e.g. harpo/, to share a bucket between installations
# S3_PREFIX=
