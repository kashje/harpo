# Copy to .env.test and fill in values for running tests.
# Vitest loads this via vitest.setup.ts. Tests fail if this file or required vars are missing.
#
# Quick start with Docker test DB:
#   docker compose -f compose.test.yml up -d
#   cp .env.test.example .env.test
#   # Edit .env.test: set URL_ID_ENC_KEY (openssl rand -base64 32) and CREATOR_FINGERPRINT_SALT
#   pnpm test:db:push
#   pnpm test:run

NODE_ENV=test

# Test database — matches compose.test.yml (postgres on host port 5433)
DATABASE_URL="postgresql://harpo:harpo@test-db:5433/harpo_test"

# Must be a 32-byte key encoded as base64 (e.g. openssl rand -base64 32)
URL_ID_ENC_KEY=""
CREATOR_FINGERPRINT_SALT="your-test-salt"

# Client-side (number)
NEXT_PUBLIC_LAST_VIEW_COUNTDOWN_SECONDS=30 # This is used the test so don't set it too high
